# Environment Configuration for Docker Deployment

# Application Settings
APP_ENV=production
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Inference Settings
# Note: The model artifact should be mounted as a volume or built into the image
MODEL_PATH=models/onnx/best.onnx

# Integration Settings
PLC_ENABLED=false
PROMETHEUS_ENABLED=true

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
