# =========================================================================
# PRODUCTION ML / YOLO PROJECT .GITIGNORE
# =========================================================================

# -------------------------------------------------------------------------
# Python Environments & Caches
# -------------------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# -------------------------------------------------------------------------
# IDEs & OS Files
# -------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.gemini/

# -------------------------------------------------------------------------
# Jupyter Notebooks
# -------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# -------------------------------------------------------------------------
# Data (Raw, Interim, Processed, External)
# -------------------------------------------------------------------------
# Ignore all data but keep the directory structures using .gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# -------------------------------------------------------------------------
# Model Weights (PyTorch, ONNX, TensorRT)
# -------------------------------------------------------------------------
# Prevent committing large weight files anywhere in the project
*.pt
*.pth
*.onnx
*.engine
*.trt
*.pb
*.h5

# Specific Model Directories
models/pytorch/*
!models/pytorch/.gitkeep
models/onnx/*
!models/onnx/.gitkeep
models/tensorrt/*
!models/tensorrt/.gitkeep

# -------------------------------------------------------------------------
# YOLO & Ultralytics Specific
# -------------------------------------------------------------------------
# Ultralytics saves predictions and training logs in runs/ by default
runs/
yolov8n.pt

# -------------------------------------------------------------------------
# Experiment Tracking (WandB, MLFlow, Tensorboard)
# -------------------------------------------------------------------------
wandb/
mlruns/
tb_logs/

# -------------------------------------------------------------------------
# Generated files, Logs, Reports
# -------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp

reports/experiments/*
!reports/experiments/.gitkeep
reports/evaluation/*
!reports/evaluation/.gitkeep
reports/error_analysis/*
!reports/error_analysis/.gitkeep
reports/benchmarks/*
!reports/benchmarks/.gitkeep

# Dataset validation generated files
reports/dataset_validation/samples/
reports/dataset_validation/annotations/